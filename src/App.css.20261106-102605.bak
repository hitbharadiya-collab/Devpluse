:root {
  --dp-bg: #0b1120;
  --dp-sidebar: #0d1525;
  --dp-panel: #111c2d;
  --dp-panel-hover: #162338;
  --dp-border: #243247;
  --dp-text: #e8eef8;
  --dp-muted: #8b9bb2;
  --dp-blue: #5b8cff;
  --dp-purple: #9b7cff;
  --dp-green: #39c99a;
  --dp-red: #ff6b7a;
  --dp-yellow: #f4bd50;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--dp-bg);
  color: var(--dp-text);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  background: var(--dp-bg);
}

.sidebar {
  width: 250px;
  flex-shrink: 0;
  min-height: 100vh;
  background: var(--dp-sidebar);
  border-right: 1px solid var(--dp-border);
  display: flex;
  flex-direction: column;
  padding: 22px 14px 16px;
  transition: transform .25s ease;
  z-index: 30;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px 26px;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -.6px;
}

.brand-icon {
  width: 37px;
  height: 37px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #4d8bff, #7958e8);
  color: white;
  box-shadow: 0 5px 20px #4d8bff30;
}

.workspace {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  margin-bottom: 24px;
  border: 1px solid var(--dp-border);
  border-radius: 12px;
  background: #121e30;
}

.workspace-avatar {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: #253d67;
  color: #a9c8ff;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.workspace-info,
.profile-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.workspace-info strong,
.profile-info strong {
  font-size: 12px;
  font-weight: 650;
}

.workspace-info small,
.profile-info small {
  font-size: 11px;
  color: var(--dp-muted);
}

.nav-section {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-bottom: 23px;
}

.nav-heading {
  color: #6f809a;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.3px;
  padding: 0 12px 9px;
}

.nav-item {
  width: 100%;
  min-height: 41px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: #9aaac0;
  text-align: left;
  font-size: 13px;
  transition: background .2s, color .2s;
}

.nav-item:hover {
  background: #172338;
  color: #e5edfa;
}

.nav-item.active {
  color: #a9c6ff;
  background: #1b2d4a;
  border-color: #2c4772;
}

.nav-count {
  margin-left: auto;
  padding: 2px 7px;
  border-radius: 6px;
  background: #263650;
  color: #b9c9e3;
  font-size: 10px;
}

.tools-section {
  margin-top: 2px;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 18px;
}

.upgrade-card {
  border: 1px solid #2b3d60;
  border-radius: 12px;
  padding: 14px;
  background: linear-gradient(145deg, #172640, #121b30);
  margin-bottom: 15px;
}

.upgrade-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: #bba7ff;
  background: #302858;
  border-radius: 9px;
  margin-bottom: 11px;
}

.upgrade-card strong {
  display: block;
  font-size: 12px;
  margin-bottom: 6px;
}

.upgrade-card p {
  font-size: 11px;
  line-height: 1.6;
  color: #91a3bf;
  margin: 0 0 12px;
}

.upgrade-card button {
  width: 100%;
  border: 0;
  border-radius: 7px;
  padding: 9px;
  background: #466fe0;
  color: white;
  font-size: 11px;
  font-weight: 650;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 8px 3px;
  border-top: 1px solid var(--dp-border);
}

.profile-avatar,
.top-avatar {
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #4367a8, #7956b8);
  color: white;
  font-weight: 700;
}

.profile-avatar {
  width: 35px;
  height: 35px;
  font-size: 12px;
}

.sidebar-overlay {
  display: none;
}

.main-content {
  min-width: 0;
  flex: 1;
}

.topbar {
  min-height: 72px;
  padding: 0 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid var(--dp-border);
  background: #0d1523;
}

.topbar-left,
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #9aabc3;
  font-size: 12px;
}

.breadcrumb-separator {
  color: #52627a;
}

.top-search {
  width: 260px;
  height: 37px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 11px;
  background: #121d2e;
  border: 1px solid var(--dp-border);
  border-radius: 9px;
  color: #8092ac;
}

.top-search input {
  width: 100%;
  min-width: 0;
  outline: none;
  border: 0;
  background: transparent;
  color: var(--dp-text);
  font-size: 12px;
}

.top-search input::placeholder {
  color: #75869e;
}

.top-search kbd {
  flex-shrink: 0;
  padding: 3px 5px;
  border: 1px solid #34435a;
  border-radius: 5px;
  color: #9eacc1;
  font-size: 10px;
}

.notification-wrapper {
  position: relative;
}

.topbar-actions > button,
.notification-wrapper > button {
  width: 36px;
  height: 36px;
  border: 1px solid var(--dp-border);
  border-radius: 9px;
  background: #121d2e;
  color: #9cacc3;
  display: grid;
  place-items: center;
}

.topbar-actions button:hover {
  color: white;
  background: #1a2940;
}

.top-avatar {
  width: 35px;
  height: 35px;
  border: 0;
  font-size: 11px;
}

.notification-popover {
  position: absolute;
  top: 47px;
  right: 0;
  width: 300px;
  padding: 15px;
  border: 1px solid var(--dp-border);
  border-radius: 13px;
  background: #142034;
  box-shadow: 0 18px 45px #0005;
  z-index: 50;
}

.popover-heading {
  font-weight: 700;
  font-size: 13px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--dp-border);
}

.page-container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 30px 34px 24px;
}

.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 27px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8ca2c2;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.1px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.status-pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--dp-green);
  box-shadow: 0 0 12px #39c99a70;
}

.welcome-section h1 {
  margin: 0;
  font-size: clamp(24px, 3vw, 31px);
  letter-spacing: -1px;
  line-height: 1.25;
  font-weight: 720;
}

.welcome-section h1 span {
  color: #8faeff;
}

.welcome-section p {
  color: var(--dp-muted);
  font-size: 13px;
  line-height: 1.6;
  margin: 9px 0 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.stat-card {
  min-width: 0;
  padding: 18px;
  border: 1px solid var(--dp-border);
  border-radius: 13px;
  background: var(--dp-panel);
  transition: border-color .2s, transform .2s;
}

.stat-card:hover {
  border-color: #354b6a;
  transform: translateY(-2px);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 17px;
}

.stat-top > span:first-child {
  color: #91a2bb;
  font-size: 12px;
}

.stat-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #1d3151;
  color: #85aaff;
}

.stat-value {
  font-size: clamp(24px, 2.5vw, 30px);
  font-weight: 750;
  letter-spacing: -1px;
  line-height: 1.2;
}

.stat-footer {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  color: #7f91aa;
  font-size: 11px;
}

.trend {
  color: var(--dp-green);
  font-weight: 650;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(270px, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}

.panel {
  min-width: 0;
  border: 1px solid var(--dp-border);
  border-radius: 13px;
  background: var(--dp-panel);
  overflow: hidden;
}

.performance-panel,
.pipeline-panel,
.projects-panel,
.activity-panel {
  padding: 20px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 20px;
}

.panel-header h2 {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
}

.panel-header p {
  margin: 6px 0 0;
  color: var(--dp-muted);
  font-size: 11px;
}

.select-button {
  border: 1px solid #2a3b53;
  border-radius: 8px;
  padding: 8px 10px;
  background: #152238;
  color: #aabbd3;
  font-size: 11px;
  outline: none;
}

.chart-legend {
  display: flex;
  gap: 17px;
  align-items: center;
  color: #92a3ba;
  font-size: 11px;
}

.legend-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  margin-right: 6px;
}

.builds-dot {
  background: var(--dp-blue);
}

.deployments-dot {
  background: var(--dp-purple);
}

.chart-container {
  width: 100%;
  height: 260px;
  min-width: 0;
}

.chart-container svg {
  overflow: visible;
}

.pipeline-score {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 0 22px;
}

.score-ring {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background: conic-gradient(var(--dp-green) 0deg 306deg, #24364a 306deg 360deg);
  display: grid;
  place-items: center;
  position: relative;
}

.score-inner {
  width: 125px;
  height: 125px;
  border-radius: 50%;
  background: var(--dp-panel);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.score-inner strong {
  font-size: 30px;
  letter-spacing: -1px;
}

.score-inner span {
  font-size: 10px;
  color: var(--dp-muted);
  margin-top: 5px;
}

.pipeline-details {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-top: 17px;
  border-top: 1px solid var(--dp-border);
}

.pipeline-details > div {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #a2b2c8;
  font-size: 12px;
}

.pipeline-details strong {
  margin-left: auto;
  color: #e5edf8;
  font-size: 12px;
}

.detail-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.green-dot {
  background: var(--dp-green);
}

.red-dot {
  background: var(--dp-red);
}

.yellow-dot {
  background: var(--dp-yellow);
}

.pipeline-footer {
  margin-top: 17px;
  padding-top: 13px;
  border-top: 1px solid var(--dp-border);
  color: #8295af;
  font-size: 11px;
}

.bottom-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(270px, 1fr);
  gap: 18px;
}

.text-button {
  border: 0;
  background: transparent;
  color: #8eb0ff;
  font-size: 11px;
  font-weight: 600;
  padding: 5px;
}

.projects-list {
  display: flex;
  flex-direction: column;
}

.project-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px 0;
  border-bottom: 1px solid #202e42;
}

.project-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.project-symbol {
  flex-shrink: 0;
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border: 1px solid #2a3e5b;
  border-radius: 10px;
  background: #1a2a43;
  color: #9bb9ff;
}

.project-main {
  min-width: 0;
  flex: 1;
}

.project-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.project-title-row strong {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  font-weight: 650;
}

.project-status {
  flex-shrink: 0;
  padding: 4px 7px;
  border-radius: 6px;
  background: #20334b;
  color: #9eb8e8;
  font-size: 10px;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  color: #7f92ac;
  font-size: 10px;
}

.progress-track {
  height: 5px;
  flex: 1;
  border-radius: 99px;
  overflow: hidden;
  background: #26354a;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #4c82f4, #8a7bff);
}

.project-team {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.project-team span {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  margin-left: -6px;
  border: 2px solid var(--dp-panel);
  border-radius: 50%;
  background: #344e77;
  color: #d6e4ff;
  font-size: 9px;
  font-weight: 650;
}

.project-team span:first-child {
  margin-left: 0;
}

.empty-state {
  padding: 28px 10px;
  text-align: center;
  color: var(--dp-muted);
  font-size: 12px;
}

.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  gap: 11px;
  padding: 14px 0;
  border-bottom: 1px solid #202e42;
}

.activity-item:first-child {
  padding-top: 0;
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-icon {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #1c2d48;
  color: #91b3ff;
}

.activity-content {
  min-width: 0;
  flex: 1;
}

.activity-content p {
  margin: 0;
  color: #b8c6d9;
  font-size: 11px;
  line-height: 1.6;
}

.activity-content strong {
  color: #e6edf8;
  font-weight: 650;
}

.activity-content small {
  display: block;
  margin-top: 5px;
  color: #7589a4;
  font-size: 10px;
}

.dashboard-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 24px;
  padding-top: 17px;
  border-top: 1px solid var(--dp-border);
  color: #64758e;
  font-size: 10px;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: #030712b8;
  backdrop-filter: blur(7px);
  z-index: 100;
}

.project-modal {
  width: min(100%, 460px);
  padding: 24px;
  border: 1px solid #2b3b53;
  border-radius: 16px;
  background: #121e30;
  box-shadow: 0 25px 80px #0007;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}

.modal-header h2 {
  margin: 0;
  font-size: 18px;
}

.project-modal label {
  display: block;
  margin: 14px 0 7px;
  color: #a5b5ca;
  font-size: 12px;
}

.project-modal input,
.project-modal select {
  width: 100%;
  padding: 11px 12px;
  border: 1px solid #2c3d55;
  border-radius: 9px;
  outline: none;
  background: #0d1727;
  color: #e7edf7;
}

.project-modal input:focus,
.project-modal select:focus {
  border-color: #5b8cff;
  box-shadow: 0 0 0 3px #5b8cff20;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 23px;
}

.modal-actions button {
  padding: 10px 15px;
  border: 1px solid #2c3d55;
  border-radius: 9px;
  background: #18263b;
  color: #c0cee0;
  font-size: 12px;
}

.modal-actions button:last-child {
  border-color: #4d79e8;
  background: #4d79e8;
  color: white;
}

@media (max-width: 1150px) {
  .sidebar {
    width: 225px;
  }

  .topbar {
    padding: 0 24px;
  }

  .page-container {
    padding: 25px 24px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid,
  .bottom-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .pipeline-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 25px;
  }

  .pipeline-panel .panel-header {
    grid-column: 1 / -1;
  }

  .pipeline-score {
    padding: 0;
  }

  .pipeline-details {
    justify-content: center;
  }

  .pipeline-footer {
    grid-column: 1 / -1;
  }
}

@media (max-width: 850px) {
  .sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    transform: translateX(-100%);
    height: 100vh;
    overflow-y: auto;
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
  }

  .sidebar-overlay {
    position: fixed;
    inset: 0;
    display: block;
    background: #0008;
    border: 0;
    z-index: 20;
  }

  .topbar {
    min-height: 65px;
    padding: 0 18px;
  }

  .topbar-left,
  .topbar-actions {
    gap: 10px;
  }

  .top-search {
    width: 210px;
  }

  .page-container {
    padding: 23px 18px;
  }
}

@media (max-width: 600px) {
  .topbar {
    flex-wrap: wrap;
    padding: 12px 15px;
  }

  .topbar-left {
    width: 100%;
    justify-content: space-between;
  }

  .topbar-actions {
    width: 100%;
    justify-content: flex-end;
  }

  .top-search {
    width: min(100%, 230px);
  }

  .breadcrumb {
    font-size: 11px;
  }

  .welcome-section {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .welcome-section h1 {
    font-size: 25px;
  }

  .stats-grid {
    gap: 10px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-top {
    margin-bottom: 13px;
  }

  .stat-top > span:first-child {
    font-size: 11px;
  }

  .stat-value {
    font-size: 24px;
  }

  .stat-footer {
    flex-wrap: wrap;
    font-size: 10px;
  }

  .performance-panel,
  .pipeline-panel,
  .projects-panel,
  .activity-panel {
    padding: 15px;
  }

  .pipeline-panel {
    display: block;
  }

  .pipeline-score {
    padding: 10px 0 20px;
  }

  .chart-container {
    height: 220px;
  }

  .chart-legend {
    gap: 10px;
    font-size: 10px;
  }

  .project-team {
    display: none;
  }

  .project-title-row {
    align-items: flex-start;
  }

  .dashboard-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .notification-popover {
    position: fixed;
    top: 125px;
    right: 12px;
    width: min(300px, calc(100vw - 24px));
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
/* Project CRUD actions */
.project-row {
  gap: 12px;
}

.project-actions {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-left: auto;
  flex-shrink: 0;
}

.project-action-button {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #30394c;
  border-radius: 9px;
  background: #171e2d;
  color: #aeb9cc;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.project-action-button:hover {
  background: #252f43;
  color: #ffffff;
  border-color: #65718a;
}

.project-action-button.delete:hover {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
  border-color: rgba(239, 68, 68, 0.4);
}

.project-action-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.project-modal select {
  width: 100%;
  min-height: 42px;
  margin: 7px 0 16px;
  padding: 0 12px;
  border: 1px solid #30394c;
  border-radius: 9px;
  background: #111827;
  color: #e2e8f0;
  outline: none;
}

.project-modal select:focus {
  border-color: #8b78ff;
}

.project-modal input,
.project-modal textarea {
  width: 100%;
}

.project-modal input:disabled,
.project-modal textarea:disabled,
.project-modal select:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.modal-error {
  margin: 0 0 14px;
  padding: 10px 12px;
  border: 1px solid rgba(239, 68, 68, 0.35);
  border-radius: 9px;
  background: rgba(239, 68, 68, 0.1);
  color: #fca5a5;
  font-size: 13px;
}

@media (max-width: 520px) {
  .project-row {
    align-items: flex-start;
  }

  .project-actions {
    gap: 5px;
  }

  .project-action-button {
    width: 31px;
    height: 31px;
  }
}
